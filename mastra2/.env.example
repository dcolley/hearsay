# Spark (OpenAI-compatible) — used by Mastra openai provider
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=sk-dummy
OPENAI_MODEL=openai/qwen3.8-flash-next

# Mastra Memory (LibSQL) — conversation + scene working memory (not Workspace)
MEMORY_DB_URL=file:./data/hearsay-memory.db
HEARSAY_RESOURCE_ID=hearsay-laptop
# Optional default IANA timezone for get_date_time (else server local)
# HEARSAY_TIMEZONE=Europe/London

# Perception WebSocket
PERCEPTION_WS_PORT=4112

# ASR — browser | http | mock
#   browser — presence Web Speech API (real STT, no whisper sidecar)
#   http    — POST ASR_URL/v1/audio/transcriptions
#   mock    — fixed phrase for loop tests only
ASR_MODE=browser
ASR_URL=http://127.0.0.1:8080
ASR_MODEL=whisper-1

# TTS — browser | http
#   browser — send tts_text; client uses SpeechSynthesis, Kokoro, or Pocket TTS/clone (Presence Settings)
#   http    — OpenAI-compatible /v1/audio/speech on TTS_URL → MP3 in tab
#             (ignores client Pocket/Kokoro prefs). Phonon offline profile:
#             mastra2/docker/ptts/compose.yaml + docs/adr-009-phonon-tts-sidecar.md
TTS_MODE=browser
TTS_URL=http://127.0.0.1:8880
TTS_MODEL=tts-1
TTS_VOICE=af_heart
# Response container: mp3 (default; Kokoro/Piper) | pcm (Phonon sidecar:
# headerless 24 kHz mono — lets the server derive playback durations, so the
# barge echo window goes dynamic per ADR-006 instead of LISTEN_ARM_MS).
TTS_FORMAT=mp3

HALF_DUPLEX=true

# VAD (presence) — separate from turn-yield
VAD_MODE=silero
VAD_ENERGY_THRESHOLD=0.02
LISTEN_ARM_MS=700

# Turn-yield while agent holds the floor (not VAD): soft → sustain + effort → hard
BARGE_IN_SUSTAIN_MS=180
BARGE_EFFORT_MS=300
BARGE_EFFORT_THRESHOLD=0.35

# Echo window past audio actually issued to the browser (ADR-006). Only a
# fallback (LISTEN_ARM_MS) applies when chunk durations are unavailable.
# BARGE_ECHO_MARGIN_MS=300

# Web stop fade lives client-side: NEXT_PUBLIC_BARGE_FADE_MS in web/.env.local
# (default 150 ms, ADR-006). No server-side knob.

# Turn end — adaptive (adaptive silence) | silence (fixed 600ms)
# With ASR_MODE=browser, STT finals own commit.
TURN_MODE=adaptive

# ML end-of-turn gate (ADR-005). off = heuristic only (default, bit-identical).
# Fetch weights first: yarn models (explicit; no postinstall hook).
# Missing model with smartturn requested: warns once + behaves like off.
# TURN_GATE=smartturn
# TURN_GATE_GRACE_MS=600
# SMART_TURN_MODEL_PATH=~/.cache/hearsay/smart-turn-v3.2-cpu.onnx
# SMART_TURN_THRESHOLD=0.5

# Speculative generation (ADR-007). Budget ms; 0 = off (default, bit-identical).
# Starts ASR + LLM at likely-EOU; output held, tools off, memory writes gated.
# http|mock ASR only - browser STT owns commit there.
# SPECULATE_MS=800
# SPECULATE_ADVANCE_MS=200

# Duplex barge-in (headphones recommended; keep false on speakers until AEC validated)
# When true: cascade turn-yield soft-pause → sustain + effort → hard stop
BARGE_IN_ENABLED=false

# Progress speech (ADR-003): spoken updates while tools run.
# false = silence until the answer. Timings: ack, still-interval, still cap.
# PROGRESS_ENABLED=true
# PROGRESS_ACK_MS=3000
# PROGRESS_STILL_MS=20000
# PROGRESS_MAX_STILL=6

# Tool contracts (ADR-008): wall deadline for sync/client tools, cancelled
# with the turn abort. HITL tools (ask_user, offer_choices) never get one.
# TOOL_TIMEOUT_MS=15000

# Deferred announcements (ADR-008): async tool results wait for a silent
# streak, then speak once. Results older than the TTL are dropped.
# ANNOUNCE_SILENCE_MS=1200
# ANNOUNCE_TTL_MS=120000

# Advertise vision support in hello_ack (client still Start/Stop camera)
VISION_ENABLED=true

# Web search (Tavily) — used by web_search tool on hearsay-agent
TAVILY_API_KEY=
