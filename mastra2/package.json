{
  "name": "hearsay-server",
  "version": "0.1.0",
  "description": "Hearsay Mastra Studio + laptop perception",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "perception": "tsx src/mastra/perception/main.ts",
    "models": "bash src/mastra/perception/scripts/fetch-smart-turn.sh",
    "dev:all": "concurrently -k -n studio,perception -c blue,magenta \"yarn dev\" \"yarn perception\"",
    "test": "tsx --test src/mastra/perception/**/*.test.ts",
    "build": "mastra build",
    "start": "mastra start"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "mastra": "^1.34.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.2",
    "@ag-ui/core": "^1.0.2",
    "@ag-ui/mastra": "^2.0.0",
    "@copilotkit/runtime": "^1.78.0",
    "@mastra/client-js": "^1.53.0",
    "@mastra/core": "^1.76.0",
    "@mastra/libsql": "^1.26.0",
    "@mastra/memory": "^1.37.0",
    "@mastra/tavily": "^1.1.2",
    "avr-vad": "^1.0.10",
    "dotenv": "^18.0.7",
    "ws": "^8.22.0",
    "zod": "^4"
  }
}
